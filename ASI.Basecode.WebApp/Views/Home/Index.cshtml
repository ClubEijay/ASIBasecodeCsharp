@{
    ViewData["Title"] = "Home";
}

<div class="welcome-section">
    <div class="container">
        <i class="fas fa-book-reader bookshelf-icon"></i>
        <h1 class="welcome-title">Welcome to Alliance Library</h1>
        <p class="book-description">
            Discover our collection of books and manage your digital library with ease.
            Browse, add, edit, and organize your books all in one place.
        </p>
        <a asp-controller="Book" asp-action="Index" class="glow-button">
            <i class="fas fa-books"></i> View Books
        </a>
    </div>
</div>

@section Styles {
    <link href="~/css/book-styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
}
