@model ASI.Basecode.Data.Models.Book

<div class="container pt-5 d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="book-card" style="max-width: 500px; width: 100%;">
        <div class="card-body">
            <h2 class="book-title text-center mb-4"><i class="fas fa-trash"></i> Delete Book</h2>
            <h5 class="text-center mb-3 text-danger">Are you sure you want to delete this book?</h5>
            <dl class="row mb-4">
                <dt class="col-sm-4">Title</dt>
                <dd class="col-sm-8">@Model.Title</dd>
                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>
                <dt class="col-sm-4">Author</dt>
                <dd class="col-sm-8">@Model.Author</dd>
                <dt class="col-sm-4">Published Date</dt>
                <dd class="col-sm-8">@Model.PublishedDate?.ToShortDateString() ?? ""</dd>
            </dl>
            <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="glow-button" style="background: #dc3545;"><i class="fas fa-trash"></i> Delete</button>
                <a asp-action="Index" class="glow-button" style="background: #ccc; color: #333;"><i class="fas fa-arrow-left"></i> Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/book-styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
}